<Window
    x:Class="VegasScoutUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VegasScoutUI.Models"
    mc:Ignorable="d"
    Title="Vegas Scout AI — Intelligent Footage Culling">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
            <!-- Bottom Export Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEC50;" FontSize="22" Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock Text="Vegas Scout AI" FontSize="20" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                            <TextBlock Text="VEGAS PRO 2026" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Autonomous Video Motion Culling &amp; Highlight Reel Generator for VEGAS Pro" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="#22C55E" />
                            <TextBlock Text="NVIDIA RTX 4080 (CUDA NVDEC)" FontSize="12" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="1" Padding="24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="1100">

                <!-- 1. FOOTAGE SELECTION CARD & DROP ZONE -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="1. Source Footage Directory" FontSize="14" FontWeight="SemiBold" />

                        <!-- Drag & Drop Zone -->
                        <Border x:Name="DropZone" 
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{ThemeResource SystemAccentColor}" 
                                BorderThickness="2" 
                                CornerRadius="6" 
                                Padding="20"
                                AllowDrop="True"
                                DragOver="DropZone_DragOver"
                                Drop="DropZone_Drop">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="32" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center" />
                                <TextBlock Text="Drag and drop your raw footage folder here" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" />
                                <TextBlock Text="or click Browse to choose a folder on disk" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFolderPath" PlaceholderText="Select or paste video folder path (e.g. F:\Arrow\arrow kite surf 2\sorted 2\drone)" VerticalAlignment="Center" TextChanged="TxtFolderPath_TextChanged" />
                            <Button Grid.Column="1" Click="BtnBrowse_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="Browse Folder" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="PnlFolderStats" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="TxtFileCount" Text="146 video files found" FontSize="12" FontWeight="Medium" />
                            </Border>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="TxtSubfolders" Text="3 location subfolders" FontSize="12" FontWeight="Medium" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. AI CULLING & PROMO PARAMETERS -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="2. Culling &amp; Promo Settings" FontSize="14" FontWeight="SemiBold" />

                        <Grid ColumnSpacing="24" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cut Duration Slider -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <Grid>
                                    <TextBlock Text="Target Promo Cut Duration" FontSize="13" />
                                    <TextBlock x:Name="TxtCutDurationValue" Text="3.5s" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <Slider x:Name="SliderDuration" Minimum="1.5" Maximum="6.0" StepFrequency="0.5" Value="3.5" ValueChanged="SliderDuration_ValueChanged" />
                                <TextBlock Text="Extracts high-energy bursts matching promo pacing" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Max Cuts Per Long Take -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <Grid>
                                    <TextBlock Text="Max Highlights per Long Flight / Take" FontSize="13" />
                                    <TextBlock x:Name="TxtMaxPeaksValue" Text="3 cuts" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <Slider x:Name="SliderMaxPeaks" Minimum="1" Maximum="4" StepFrequency="1" Value="3" ValueChanged="SliderMaxPeaks_ValueChanged" />
                                <TextBlock Text="For long flights (1-2 min), pulls multiple distinct moments" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="24" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Track Layout Mode -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Timeline Track Organization" FontSize="13" />
                                <ComboBox x:Name="ComboTrackMode" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="Separate Tracks by Location / Folder (Recommended)" Tag="location" />
                                    <ComboBoxItem Content="Single Consolidated Track ([AI SELECTS] Highlights)" Tag="single" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Hardware Acceleration -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Hardware Acceleration" FontSize="13" />
                                <ToggleSwitch x:Name="ToggleGpu" Header="NVIDIA CUDA &amp; NVDEC Decoding" IsOn="True" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. EXECUTION & LIVE PROGRESS CARD -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="BtnStartScout" Click="BtnStartScout_Click" Style="{StaticResource AccentButtonStyle}" Padding="20,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="15" />
                                        <TextBlock Text="Start AI Culling" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCancel" Click="BtnCancel_Click" Visibility="Collapsed" Padding="16,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>

                        <ProgressBar x:Name="ProgressBarScout" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Height="6" CornerRadius="3" />

                        <Grid x:Name="PnlStatusDetails" Visibility="Collapsed">
                            <TextBlock x:Name="TxtStatusMessage" Text="Initializing CUDA decoder..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtCutsCounter" Text="0 cuts detected" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Right" />
                        </Grid>

                        <InfoBar x:Name="InfoBarNotification" IsOpen="False" Severity="Informational" />
                    </StackPanel>
                </Border>

                <!-- 4. DETECTED SELECTS GALLERY / RESULTS -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Detected Action &amp; Promo Cuts" FontSize="14" FontWeight="SemiBold" />
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                                    <TextBlock x:Name="TxtBadgeCount" Text="0 Cuts" FontSize="11" FontWeight="Medium" />
                                </Border>
                            </StackPanel>

                            <TextBox x:Name="TxtSearchCuts" PlaceholderText="Search by clip name or location..." Width="260" HorizontalAlignment="Right" TextChanged="TxtSearchCuts_TextChanged" />
                        </Grid>

                        <ListView x:Name="ListSelects" MaxHeight="320" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SelectClipItem">
                                    <Grid Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Glyph="&#xE8B2;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="13" />
                                            <TextBlock Text="{x:Bind TrackName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedIn}" FontSize="11" FontFamily="Consolas" />
                                        </Border>

                                        <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedDuration}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>

                                        <Border Grid.Column="4" Background="#1E3A8A" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedScore}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER / EXPORT BAR -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="24,14">
            <Grid>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSummaryFooter" Text="Ready to scan footage. Select a folder to begin." FontSize="13" FontWeight="Medium" />
                    <TextBlock x:Name="TxtManifestPath" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenManifest" Click="BtnOpenManifest_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock Text="Open Manifest" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSendToVegas" Click="BtnSendToVegas_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="🎬 Send to VEGAS Pro 2026" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
